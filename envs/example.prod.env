# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
ENV=prod
# 반드시 팀 고유 값으로 교체하세요: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_VERSION=v1.0.0
SECRET_KEY=oz-codingschool-AI-health260127!@

# ai-worker
AI_WORKER_VERSION=v1.0.0

# db
DB_HOST=mysql
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=ozcoding
DB_PASSWORD=Password1234@
DB_ROOT_PASSWORD=Ozcoding1234@
DB_NAME=ai_health

# redis
REDIS_PORT=6379

# cors (쉼표로 구분, 비우면 CORS 미들웨어 없음)
CORS_ORIGINS=

# image storage (local: 개발용 로컬 폴더, s3: AWS S3)
STORAGE_BACKEND=s3
AWS_REGION=ap-northeast-2
S3_BUCKET=
S3_PRESIGNED_URL_EXPIRE_SECONDS=600

# external api keys (실제 값은 커밋하지 말 것)
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=
ANTHROPIC_API_KEY=

# demo login (A1)
DEMO_GUARDIAN_EMAIL=demo@pillymate.com
DEMO_LOGIN_ENABLED=false

VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=