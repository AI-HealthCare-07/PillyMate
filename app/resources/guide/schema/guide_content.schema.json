{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pillymate.example/schema/guide_content/0.3",
  "title": "PillyMate guide_content v0.3 (guide 테이블 JSONB에 저장되는 최종 가이드)",
  "description": "필드마다 x-filled-by로 누가 채우는지 표시한다. server = BE·AI-2 코드가 DB·템플릿에서 그대로 복사, llm = LLM Structured Output, rule = 코드 규칙(나이·체중·제형). 용량·횟수·위험 신호·면책 문구는 LLM이 만들지 않는다.",
  "type": "object",
  "required": [
    "schema_version",
    "prescription_id",
    "generated_at",
    "status",
    "child",
    "diagnosis_label",
    "summary",
    "medications",
    "home_care",
    "warning_signs",
    "age_notes",
    "today_checklist",
    "disclaimer",
    "sources",
    "focus_points",
    "basis",
    "verification"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.3",
      "x-filled-by": "server"
    },
    "prescription_id": {
      "type": "integer",
      "x-filled-by": "server"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "x-filled-by": "server"
    },
    "status": {
      "enum": [
        "ok",
        "fallback"
      ],
      "description": "fallback = LLM 호출이 재시도 후에도 실패해 템플릿·DB 값만으로 만든 기본 가이드",
      "x-filled-by": "server"
    },
    "child": {
      "type": "object",
      "required": [
        "age_text",
        "age_months",
        "weight_kg",
        "allergies",
        "age_band"
      ],
      "additionalProperties": false,
      "x-filled-by": "server",
      "properties": {
        "age_text": {
          "type": "string",
          "examples": [
            "생후 3개월",
            "4세 2개월"
          ]
        },
        "age_months": {
          "type": "integer",
          "minimum": 0,
          "maximum": 227
        },
        "weight_kg": {
          "type": [
            "number",
            "null"
          ]
        },
        "allergies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "age_band": {
          "enum": [
            "영아",
            "유아",
            "학령기",
            "청소년"
          ],
          "description": "영아 0세, 유아 1~6세, 학령기 7~12세, 청소년 13세 이상"
        }
      }
    },
    "diagnosis_label": {
      "type": "string",
      "description": "보호자가 입력한 병명 그대로 (prescription.diagnosis_user_input). LLM이 바꾸거나 추측하지 않는다 (NFR-SAFE-002)",
      "x-filled-by": "server"
    },
    "disease_group": {
      "enum": [
        "cold_bronchitis",
        "otitis_sinusitis",
        "enteritis",
        "dermatitis",
        "conjunctivitis",
        "other"
      ],
      "description": "병명을 템플릿 질환군에 연결한 값. other면 home_care는 공통 템플릿만 쓴다",
      "x-filled-by": "rule"
    },
    "summary": {
      "type": "string",
      "maxLength": 200,
      "description": "오늘 처방을 2문장 이내로 요약. 진단·예후 단정 금지",
      "x-filled-by": "llm"
    },
    "medications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/medication"
      }
    },
    "home_care": {
      "type": "object",
      "required": [
        "template_id",
        "sections"
      ],
      "additionalProperties": false,
      "properties": {
        "template_id": {
          "type": "string",
          "examples": [
            "DATA-REF-006/cold_bronchitis@0.1"
          ],
          "x-filled-by": "server"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "title",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "enum": [
                  "recovery_course",
                  "hydration",
                  "eating",
                  "rest_sleep",
                  "home_environment",
                  "hygiene",
                  "daycare_outing"
                ]
              },
              "title": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "template_item_id",
                    "text"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "template_item_id": {
                      "type": "string",
                      "description": "LLM이 고른 템플릿 문장 id. 템플릿에 없는 id면 서버가 버린다"
                    },
                    "text": {
                      "type": "string",
                      "description": "템플릿 문장 원문 (서버가 id로 채움)"
                    },
                    "personal_note": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 80,
                      "description": "아이 나이·증상에 맞춘 한 줄 보충 (llm, 수치 금지)"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "with_this_medicine": {
      "type": "array",
      "description": "약과 관련된 팁은 모두 여기 (DATA-REF-007 약 계열 팁 + 질환 템플릿 중 kind=medication 문장). 생활 안내(home_care)에는 약 이야기를 넣지 않는다",
      "x-filled-by": "rule",
      "items": {
        "type": "object",
        "required": [
          "template_item_id",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "template_item_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "warning_signs": {
      "type": "object",
      "description": "요구사항: 위험 신호 반드시 포함. LLM에 맡기지 않고 템플릿에서 서버가 복사한다",
      "x-filled-by": "rule",
      "required": [
        "go_to_er",
        "see_doctor"
      ],
      "additionalProperties": false,
      "properties": {
        "go_to_er": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "see_doctor": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "age_notes": {
      "type": "array",
      "description": "공통 템플릿의 나이별 주의 중 아이 월령에 해당하는 것",
      "x-filled-by": "rule",
      "items": {
        "type": "string"
      }
    },
    "today_checklist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "x-filled-by": "rule",
      "description": "오늘의 행동 목표. 약 시간표(복약)·관리 포인트(생활)·위험 신호(관찰)에서 코드가 만든다",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "category"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 60
          },
          "category": {
            "enum": [
              "복약",
              "생활",
              "관찰"
            ]
          }
        }
      }
    },
    "disclaimer": {
      "const": "이 안내는 의료진의 진단과 처방을 대신하지 않습니다. 약의 용량이나 복용법은 처방전과 약사 안내를 따르고, 아이 상태가 걱정되면 바로 진료를 받으세요.",
      "description": "NFR-SAFE-001 고정 문구. 코드에서 삽입",
      "x-filled-by": "server"
    },
    "sources": {
      "type": "array",
      "description": "가이드에 실제로 쓰인 문장의 출처만. 화면 하단 '근거 보기'에 쓴다",
      "x-filled-by": "server",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "used_for": {
            "type": "string",
            "description": "이 출처가 쓰인 곳 (생활 안내, 위험 신호 등)"
          }
        }
      }
    },
    "symptom_notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "보호자가 입력한 증상 그대로. 없으면 null. LLM이 만들지 않는다",
      "x-filled-by": "server"
    },
    "focus_points": {
      "type": "array",
      "maxItems": 3,
      "x-filled-by": "rule",
      "description": "오늘의 관리 포인트(생활 관리만). DATA-REF-006 관리 포인트(focus)에서 아이 나이·처방 약 계열·보호자 입력 증상으로 골라 항목→이유→행동 순서로 보여 준다",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "why",
          "actions",
          "reason_for_child",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "description": "관리가 필요한 이유"
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string"
            },
            "description": "보호자가 할 일"
          },
          "reason_for_child": {
            "type": "string",
            "description": "이 아이에게 이 항목을 고른 이유 (코드가 작성)"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "x-filled-by": "server",
      "description": "이번 가이드 생성 근거. 어떤 진료 문서를 썼고, 아이 정보가 가이드에 어떻게 쓰였는지 사실대로 적는다",
      "required": [
        "documents",
        "diagnosis_codes",
        "cross_check",
        "personalization"
      ],
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "date",
              "place"
            ],
            "properties": {
              "type": {
                "enum": [
                  "처방전",
                  "약봉투"
                ]
              },
              "date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "place": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "diagnosis_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "처방전의 질병분류기호 (참고용, 병명은 보호자 입력 사용)"
        },
        "cross_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "done",
            "mismatch_count",
            "summary"
          ],
          "properties": {
            "done": {
              "type": "boolean"
            },
            "mismatch_count": {
              "type": "integer",
              "minimum": 0
            },
            "summary": {
              "type": "string"
            }
          }
        },
        "personalization": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "factor",
              "value",
              "applied"
            ],
            "properties": {
              "factor": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "applied": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "x-filled-by": "server",
      "required": [
        "generated_by",
        "template_review",
        "needs_review_count",
        "checks"
      ],
      "properties": {
        "generated_by": {
          "type": "string"
        },
        "template_review": {
          "type": "string",
          "description": "템플릿 의료진 검수 상태"
        },
        "needs_review_count": {
          "type": "integer",
          "minimum": 0,
          "description": "가이드에 쓰인 문장 중 수치가 있어 의료진 검수가 필요한 것의 수"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "생성 과정에서 적용한 안전 확인"
        }
      }
    }
  },
  "$defs": {
    "medication": {
      "type": "object",
      "required": [
        "medication_id",
        "name",
        "dosage_form",
        "route",
        "dose_text",
        "schedule",
        "purpose",
        "how_to_give",
        "cautions",
        "common_side_effects",
        "storage",
        "pharmacist_check"
      ],
      "additionalProperties": false,
      "properties": {
        "medication_id": {
          "type": "integer",
          "x-filled-by": "server"
        },
        "name": {
          "type": "string",
          "x-filled-by": "server"
        },
        "dosage_form": {
          "enum": [
            "시럽",
            "건조시럽",
            "현탁액",
            "액제",
            "산제",
            "정제",
            "캡슐",
            "로션",
            "크림",
            "연고",
            "점안액",
            "점이액",
            "비강분무제",
            "흡입제",
            "좌제",
            "기타"
          ],
          "x-filled-by": "server"
        },
        "route": {
          "enum": [
            "내복",
            "외용"
          ],
          "x-filled-by": "server"
        },
        "dose_text": {
          "type": "string",
          "examples": [
            "1회 3mL",
            "1회 1포",
            "환부에 얇게"
          ],
          "description": "DB의 dose_per_time+unit을 그대로 문자열로. LLM 계산 금지",
          "x-filled-by": "server"
        },
        "schedule": {
          "type": "object",
          "required": [
            "type",
            "daily_count",
            "max_daily_count",
            "min_interval_hours",
            "timing",
            "total_days",
            "slots",
            "usage_original"
          ],
          "additionalProperties": false,
          "x-filled-by": "rule",
          "properties": {
            "type": {
              "enum": [
                "fixed",
                "as_needed",
                "topical",
                "eye"
              ]
            },
            "daily_count": {
              "type": [
                "integer",
                "null"
              ]
            },
            "max_daily_count": {
              "type": [
                "integer",
                "null"
              ],
              "description": "필요시 약의 하루 최대 횟수 (처방전 1일 투여횟수)"
            },
            "min_interval_hours": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "필요시 약의 최소 복용 간격(시간). 약봉투·용법에 적힌 숫자만 쓰고 없으면 null (추측 금지). 필요시 알림에 사용"
            },
            "timing": {
              "enum": [
                "식전 30분",
                "식전",
                "식후 즉시",
                "식후 30분",
                "식후 2시간",
                "식후",
                "수유 후 30분",
                "수유 후",
                null
              ],
              "description": "용법 문구에서 읽은 복용 시점. 없으면 null"
            },
            "total_days": {
              "type": [
                "integer",
                "null"
              ]
            },
            "slots": {
              "type": "array",
              "items": {
                "enum": [
                  "아침",
                  "점심",
                  "저녁",
                  "자기 전",
                  "필요할 때"
                ]
              },
              "description": "용법 문구에 시간대(아침·점심·저녁·취침 전)가 있고 개수가 daily_count와 맞으면 그대로, 아니면 daily_count로 기본 배치 (2회=아침·저녁, 3회=아침·점심·저녁). 푸시 알림(REQ-MED-004)이 쓴다"
            },
            "usage_original": {
              "type": [
                "string",
                "null"
              ],
              "description": "처방전 용법 칸 원문"
            }
          }
        },
        "purpose": {
          "type": "string",
          "maxLength": 60,
          "description": "어떤 약인지 (예: 세균을 없애는 항생제). 병명 추측 금지",
          "x-filled-by": "llm"
        },
        "how_to_give": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "x-filled-by": "llm"
        },
        "cautions": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "x-filled-by": "llm"
        },
        "common_side_effects": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "maxLength": 40
          },
          "x-filled-by": "llm"
        },
        "storage": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80,
          "x-filled-by": "llm"
        },
        "pharmacist_check": {
          "type": "object",
          "required": [
            "needed",
            "reason"
          ],
          "additionalProperties": false,
          "description": "참조 데이터에 없는 약이거나 알레르기·연령 주의가 걸리면 needed=true. 코드 규칙이 true로 정하면 LLM이 false로 바꿀 수 없다",
          "x-filled-by": "llm+rule",
          "properties": {
            "needed": {
              "type": "boolean"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 80
            }
          }
        }
      }
    }
  }
}